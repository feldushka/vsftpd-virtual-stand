<!-- local_rules.xml - правила для vsftpd -->

<group name="vsftpd,bruteforce">
  <rule id="100001" level="5">
    <program_name>vsftpd</program_name>
    <match>FAIL LOGIN|530 Login incorrect|authentication failure</match>
    <description>vsftpd: Неудачная попытка входа</description>
  </rule>

  <rule id="100002" level="10" frequency="5" timeframe="120" ignore="600">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>vsftpd: Brute-force атака (5+ неудач за 2 минуты)</description>
  </rule>
</group>

<group name="vsftpd,dos">
  <rule id="100003" level="7">
    <program_name>vsftpd</program_name>
    <match>Too many connections|421|530 Too many|session limit|connections limit</match>
    <description>vsftpd: Достигнут лимит подключений (DoS)</description>
  </rule>

  <rule id="100004" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100003</if_matched_sid>
    <same_source_ip />
    <description>vsftpd: DoS-атака (много отказов по лимиту подключений)</description>
  </rule>
</group>

<group name="vsftpd,chroot,unauthorized">
  <rule id="100005" level="6">
    <program_name>vsftpd</program_name>
    <match>CWD /\.\.|CWD /etc|CWD /root|RETR /etc/passwd|RETR /etc/shadow|LIST /\.\.|CWD /</match>
    <description>vsftpd: Попытка выхода за пределы chroot / несанкционированный доступ</description>
  </rule>

  <rule id="100006" level="9" frequency="2" timeframe="300">
    <if_matched_sid>100005</if_matched_sid>
    <same_source_ip />
    <description>vsftpd: Множественные попытки обхода chroot / несанкционированный доступ</description>
  </rule>
</group>