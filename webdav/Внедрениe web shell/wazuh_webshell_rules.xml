<group name="syscheck,webshell,webdav,">
  <rule id="100400" level="12">
    <if_sid>550</if_sid>
    <field name="syscheck.path">/var/www/html/webdav</field>
    <match>.php$</match>
    <description>CRITICAL: Unauthorized PHP Web Shell upload detected via WebDAV!</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>
</group>
