<group name="syscheck,vsftpd,lpe_privesc,">
  <rule id="100900" level="14">
    <if_sid>550</if_sid>
    <field name="syscheck.path">/var/ftp/incoming/scripts</field>
    <match>.sh$</match>
    <description>CRITICAL: Unauthorized modification of automation script in anonymous FTP directory!</description>
    <mitre>
      <id>T1037</id>
    </mitre>
  </rule>
</group>
