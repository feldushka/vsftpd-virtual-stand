<group name="syscheck,authentication,bruteforce,">
  <rule id="100200" level="5">
    <if_sid>5716, 5760</if_sid>
    <description>Samba/FTP: Failed authentication attempt</description>
  </rule>

  <rule id="100201" level="12" frequency="6" timeframe="30">
    <if_matched_sid>100200</if_matched_sid>
    <description>CRITICAL: Brute-force attack detected on file sharing service!</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>
</group>
